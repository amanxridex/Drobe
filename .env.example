# ==============================================================================
# DROBE AHMEDABAD DARKSTORE - SUPABASE ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local and fill in your Supabase project credentials.
# Your Project URL and Anon Key can be found in your Supabase Dashboard:
# Project Settings -> API -> Project URL & Project API Keys (anon / public)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-actual-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Darkstore Hub Code (Ahmedabad Shivam Bungalows 1, Koteshwar Road)
NEXT_PUBLIC_DROBE_HUB_ID=AMD-DARKSTORE-01
NEXT_PUBLIC_DROBE_EXPRESS_ZONE=Ahmedabad 30-Min Zone

# ==============================================================================
# UPSTASH REDIS EDGE CACHING & RATE LIMITING (Optional in dev, active in prod)
# ==============================================================================
# If omitted or invalid, Drobe automatically falls back to high-speed in-memory LRU cache
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token-here

